# Python environments (recreate with: python -m venv venv && pip install -r requirements.txt)
venv/
src/venv/
.venv/
__pycache__/
*.pyc

# PyInstaller working folders (the finished gui/DocIt.exe is kept)
gui/build/
gui/dist/

# Evidence: captured packages are kept; archives of removed/superseded
# packages and in-progress temp files are not
evidence/archive_*/
evidence/.*.tmp

# OS / editor noise
Thumbs.db
.DS_Store
.vscode/
.idea/

# design-tool decision-page state (session scratch)
.impeccable/questions/

# listener heartbeat (live status for the dashboard; rewritten every 2 s)
evidence/.listener.json*

# dashboard accounts: password hashes + JWT signing secret (never commit)
config/

# output of windowless runs (shown on the dashboard's Logs page)
logs/
# stop request from the dashboard to the listener (consumed within 2 s)
evidence/.listener.stop
